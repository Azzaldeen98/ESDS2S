<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true"
    tools:context=".Activies.SpeachActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:viewBindingIgnore="true"
            android:orientation="vertical"
            android:layout_marginTop="90dp"
            android:gravity="center">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="50dp"
                android:cropToPadding="true"
                android:src="@drawable/robot_splash"
                android:backgroundTint="@color/white"
                android:background="@color/white"/>
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:cropToPadding="true"
                android:layout_marginLeft="120dp"
                android:visibility="gone"
                android:padding="10dp"
                android:background="@drawable/cirecle_border"
                android:src="@drawable/baseline_record_voice_over_24"/>
        </LinearLayout>


        <Button
            android:id="@+id/btn_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:background="@color/purple_200"
            android:gravity="center"
            android:layout_marginHorizontal="30dp"
            android:text="@string/atomated_chat_btn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:background="@color/purple_200"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginHorizontal="30dp"
            android:text="@string/btn_close_service"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20dp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>